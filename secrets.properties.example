# Copy this file to secrets.properties and fill in your own keys.
# secrets.properties is git-ignored and never committed.

# Google Maps SDK for Android
MAPS_API_KEY=your_google_maps_api_key

# FAA NOTAM / TFR API credentials
FAA_CLIENT_ID=your_faa_client_id
FAA_CLIENT_SECRET=your_faa_client_secret

# Optional separate keys for debug builds
MAPS_API_KEY_DEBUG=
FAA_CLIENT_ID_DEBUG=
FAA_CLIENT_SECRET_DEBUG=
