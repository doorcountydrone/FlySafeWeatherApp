<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config>
        <domain includeSubdomains="true">aviationweather.gov</domain>
        <domain includeSubdomains="true">services.swpc.noaa.gov</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        <pin-set expiration="2025-01-01">
            <!-- Add certificate pins for your domains -->
        </pin-set>
    </domain-config>
</network-security-config> 